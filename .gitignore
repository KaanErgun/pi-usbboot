# Dependencies and generated files. Keep package-lock.json and Cargo.lock tracked.
node_modules/
__pycache__/
*.pyc
/target/
/src-tauri/target/
/src-tauri/gen/
# Prepared third-party runtimes are bundled as release assets, never committed.
/src-tauri/resources/runtime/
/dist/
/coverage/
/.cache/
# Generated by `npm run build:ui` from src-ui/main.ts.
/ui/main.js

# Release files are uploaded explicitly as release assets, never as source files.
/release/
*.app/
*.dmg
*.AppImage
*.run
*.deb
*.rpm
*.msi
*.zip
*.tar
*.tar.gz
*.tar.xz
*.tar.bz2
*.tgz
*.7z
*.rar

# Environment and local configuration. Examples must contain placeholders only.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
.direnv/
*.local
*.local.*
.npmrc
.netrc
.pypirc

